# humanize - numbers and times rendered for people.
#
# The `std.humanize` native module, rewritten in Ecko so it can leave the
# standard library (board card 66d8a29d): every function answers exactly what
# the native one does, which tests/humanize_test.ecko holds it to. Pure and
# deterministic - `relative` takes "now" as an argument rather than reading the
# clock - so its output is safe to assert on.

# The magnitude of an Int, for the formatting below. `abs` would raise on the
# most negative Int, whose magnitude does not fit; one less is invisible in
# any of these renderings.
fn magnitude(n) {
    if n >= 0 { n } else if n == -9223372036854775807 - 1 { 9223372036854775807 } else { 0 - n }
}

# A whole number from an Int or a Float (truncated toward zero), as the
# native module took them.
fn whole(x, who, what) {
    match type_of(x) {
        "int" => x
        "float" => int(x)
        _ => error({ kind: "bug", message: "humanize.{who} needs a number of {what}" })
    }
}

## The two largest non-zero units of a duration in milliseconds.
## `duration(7505000)` is `"2h 5m"`, `duration(3600000)` is `"1h"`, and anything
## under a second is milliseconds: `duration(250)` is `"250ms"`. A negative
## duration renders as its magnitude.
export fn duration(ms) {
    n = magnitude(whole(ms, "duration", "milliseconds"))
    if n == 0 { return "0s" }
    if n < 1000 { return "{n}ms" }
    total = n // 1000
    mut parts = []
    for (v, unit) in [
        [total // 86400, "d"],
        [total % 86400 // 3600, "h"],
        [total % 3600 // 60, "m"],
        [total % 60, "s"],
    ] {
        if v > 0 and len(parts) < 2 { parts = push(parts, "{v}{unit}") }
    }
    join(parts, " ")
}

# Round to a whole number, a tie to the even neighbour - what Rust's `{:.1}`
# does, and so what the native module printed: 523.25 KB is "523.2 KB", not
# "523.3". `x` is below 2^14 * 10 here, so it holds its exact value and a tie
# is a real tie.
fn tenths_even(x) {
    lo = int(floor(x))
    rest = x - float(lo)
    if rest > 0.5 { lo + 1 } else if rest < 0.5 { lo } else if lo % 2 == 0 { lo } else { lo + 1 }
}

## A byte count in 1024-based units with one decimal, trailing `.0` dropped:
## `size(1468006)` is `"1.4 MB"`, `size(1024)` is `"1 KB"`, `size(512)` is
## `"512 B"`. Units run B, KB, MB, GB, TB, PB.
export fn size(bytes) {
    b = magnitude(whole(bytes, "size", "bytes"))
    if b < 1024 { return "{b} B" }
    units = ["KB", "MB", "GB", "TB", "PB"]
    mut v = float(b) / 1024.0
    mut i = 0
    while v >= 1024.0 and i < len(units) - 1 {
        v = v / 1024.0
        i = i + 1
    }
    tenths = tenths_even(v * 10.0)
    num = if tenths % 10 == 0 { string(tenths // 10) } else { "{tenths // 10}.{tenths % 10}" }
    "{num} {units[i]}"
}

## Coarse relative time between two unix-millisecond timestamps: `event`, and
## `now` - pass `time.now()`. A later `now` reads as the past
## (`"3 days ago"`), an earlier one as the future (`"in 2 hours"`), and within
## five seconds either way is `"just now"`. Units run seconds, minutes, hours,
## days, months (30 days) and years (365 days).
export fn relative(event, now) {
    a = whole(event, "relative", "milliseconds")
    b = whole(now, "relative", "milliseconds")
    # Saturating, as the native one is: timestamps at opposite ends of the
    # range would overflow the subtraction.
    delta = try {
        b - a
    } catch (_) {
        if b > a { 9223372036854775807 } else { -9223372036854775807 - 1 }
    }
    s = magnitude(delta) // 1000
    if s < 5 { return "just now" }
    (n, unit) = if s < 60 {
        [s, "second"]
    } else if s < 3600 {
        [s // 60, "minute"]
    } else if s < 86400 {
        [s // 3600, "hour"]
    } else if s < 2592000 {
        [s // 86400, "day"]
    } else if s < 31536000 {
        [s // 2592000, "month"]
    } else {
        [s // 31536000, "year"]
    }
    word = if n == 1 { unit } else { unit + "s" }
    if delta >= 0 { "{n} {word} ago" } else { "in {n} {word}" }
}

## The English ordinal of a whole number: `ordinal(1)` is `"1st"`, `ordinal(11)`
## is `"11th"`, `ordinal(23)` is `"23rd"`. A Float is truncated first.
export fn ordinal(n) {
    k = whole(n, "ordinal", "items")
    r100 = k % 100
    r10 = k % 10
    suffix = if r100 >= 11 and r100 <= 13 {
        "th"
    } else if r10 == 1 {
        "st"
    } else if r10 == 2 {
        "nd"
    } else if r10 == 3 {
        "rd"
    } else {
        "th"
    }
    "{k}{suffix}"
}

## A count and a word, the word pluralised for anything but 1 or -1:
## `plural(3, "day")` is `"3 days"`. Pluralising only adds `s`; pass the plural
## for anything irregular: `plural(2, "person", "people")` is `"2 people"`.
export fn plural(n, singular, plural = null) {
    k = whole(n, "plural", "items")
    word = if k == 1 or k == -1 {
        singular
    } else if plural == null {
        singular + "s"
    } else {
        plural
    }
    "{k} {word}"
}
