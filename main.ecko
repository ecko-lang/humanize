# humanize - numbers and times rendered for people.
#
# The `std.humanize` native module, rewritten in Ecko so it could leave the
# standard library. It answers what the native one did, except where the
# native one was wrong (negative ordinals, a size rounding into the next unit,
# the sign of a negative size, plurals of -s/-x/-z/-ch/-sh/-y words). Pure and
# deterministic - `relative` takes "now" as an argument rather than reading the
# clock - so its output is safe to assert on.

# The magnitude of an Int, for the formatting below. `abs` would raise on the
# most negative Int, whose magnitude does not fit; one less is invisible in
# any of these renderings.
fn magnitude(n) {
    if n >= 0 { n } else if n == -9223372036854775807 - 1 { 9223372036854775807 } else { 0 - n }
}

# A value for an error message: a string quoted, anything else with its type.
fn describe(v) {
    match type_of(v) {
        "string" => "\"{v}\""
        "null" => "null"
        t => "{t} {v}"
    }
}

# Raise a programmer-mistake error naming the function and the argument.
fn bad_argument(who, arg, want, got) {
    error(
        {
            kind: "bug",
            reason: "bad_argument",
            message: "humanize.{who}: {arg} must be {want}, got {describe(got)}",
        },
    )
}

# A whole number from an Int or a finite Float (truncated toward zero), as the
# native module took them.
fn whole(x, who, arg) {
    match type_of(x) {
        "int" => x
        "float" => try { int(x) } catch (_) { bad_argument(who, arg, "a finite number", x) }
        _ => bad_argument(who, arg, "a number", x)
    }
}

## The two largest non-zero units of a duration given in milliseconds.
##
## Units are d, h, m and s; anything under a second is milliseconds, and zero
## is `"0s"`. A negative duration renders as its magnitude, and a Float is
## truncated first.
##
## errors: `bug`/`bad_argument` when `ms` is not a finite number.
##
## example:
##   humanize.duration(7505000)   # "2h 5m"
##   humanize.duration(250)       # "250ms"
export fn duration(ms) {
    n = magnitude(whole(ms, "duration", "ms"))
    if n == 0 { return "0s" }
    if n < 1000 { return "{n}ms" }
    total = n // 1000
    mut parts = []
    for (v, unit) in [
        [total // 86400, "d"],
        [total % 86400 // 3600, "h"],
        [total % 3600 // 60, "m"],
        [total % 60, "s"],
    ] {
        if v > 0 and len(parts) < 2 { parts = push(parts, "{v}{unit}") }
    }
    join(parts, " ")
}

# Round to a whole number, a tie to the even neighbour - what Rust's `{:.1}`
# does, and so what the native module printed: 523.25 KB is "523.2 KB", not
# "523.3". `x` is below 2^14 * 10 here, so it holds its exact value and a tie
# is a real tie.
fn tenths_even(x) {
    lo = int(floor(x))
    rest = x - float(lo)
    if rest > 0.5 { lo + 1 } else if rest < 0.5 { lo } else if lo % 2 == 0 { lo } else { lo + 1 }
}

## A byte count in 1024-based units with one decimal, a trailing `.0` dropped.
##
## Units run B, KB, MB, GB, TB, PB. A tie rounds to even (`535808` is
## `"523.2 KB"`), and a value that rounds up to 1024 moves to the next unit
## (`1048575` is `"1 MB"`). A negative count keeps its sign. A Float is
## truncated first.
##
## errors: `bug`/`bad_argument` when `bytes` is not a finite number.
##
## example:
##   humanize.size(1468006)   # "1.4 MB"
export fn size(bytes) {
    raw = whole(bytes, "size", "bytes")
    sign = if raw < 0 { "-" } else { "" }
    b = magnitude(raw)
    if b < 1024 { return "{sign}{b} B" }
    units = ["KB", "MB", "GB", "TB", "PB"]
    mut v = float(b) / 1024.0
    mut i = 0
    while v >= 1024.0 and i < len(units) - 1 {
        v = v / 1024.0
        i = i + 1
    }
    mut tenths = tenths_even(v * 10.0)
    if tenths >= 10240 and i < len(units) - 1 {
        tenths = tenths_even(v / 1024.0 * 10.0)
        i = i + 1
    }
    num = if tenths % 10 == 0 { string(tenths // 10) } else { "{tenths // 10}.{tenths % 10}" }
    "{sign}{num} {units[i]}"
}

## Coarse relative time from `now` to `event`, both unix-millisecond timestamps.
##
## A later `now` reads as the past (`"3 days ago"`), an earlier one as the
## future (`"in 2 hours"`), and within five seconds either way is
## `"just now"`. Units run seconds, minutes, hours, days, months (30 days) and
## years (365 days). Pass `time.now()` as `now`; taking it as an argument keeps
## the result deterministic.
##
## errors: `bug`/`bad_argument` when either timestamp is not a finite number.
##
## example:
##   humanize.relative(0, 259200000)   # "3 days ago"
export fn relative(event, now) {
    a = whole(event, "relative", "event")
    b = whole(now, "relative", "now")
    # Saturating, as the native one is: timestamps at opposite ends of the
    # range would overflow the subtraction.
    delta = try {
        b - a
    } catch (_) {
        if b > a { 9223372036854775807 } else { -9223372036854775807 - 1 }
    }
    s = magnitude(delta) // 1000
    if s < 5 { return "just now" }
    (n, unit) = if s < 60 {
        [s, "second"]
    } else if s < 3600 {
        [s // 60, "minute"]
    } else if s < 86400 {
        [s // 3600, "hour"]
    } else if s < 2592000 {
        [s // 86400, "day"]
    } else if s < 31536000 {
        [s // 2592000, "month"]
    } else {
        [s // 31536000, "year"]
    }
    word = if n == 1 { unit } else { unit + "s" }
    if delta >= 0 { "{n} {word} ago" } else { "in {n} {word}" }
}

# A Float's Int value when it is whole and fits, else null.
fn whole_float(x) {
    try {
        k = int(x)
        if float(k) == x { k } else { null }
    } catch (_) { null }
}

## The English ordinal of a whole number.
##
## 11, 12 and 13 take "th" despite ending in 1, 2 and 3, and a negative number
## takes the suffix of its magnitude (`-1st`), as the `inflect` package does. A
## Float is accepted only when it is whole (`3.0`).
##
## errors: `bug`/`bad_argument` when `n` is not an Int or a whole Float.
##
## example:
##   humanize.ordinal(23)    # "23rd"
##   humanize.ordinal(-11)   # "-11th"
export fn ordinal(n) {
    k = match type_of(n) {
        "int" => n
        "float" => whole_float(n)
        _ => null
    }
    if is_null(k) { bad_argument("ordinal", "n", "a whole number", n) }
    digits = filter(chars(string(k)), fn(c) c != "-")
    last_two = int(join(drop(digits, max(len(digits) - 2, 0)), "")) % 100
    last_one = last_two % 10
    suffix = if last_two >= 11 and last_two <= 13 {
        "th"
    } else if last_one == 1 {
        "st"
    } else if last_one == 2 {
        "nd"
    } else if last_one == 3 {
        "rd"
    } else {
        "th"
    }
    "{k}{suffix}"
}

# The regular English plural: -es after s, x, z, ch and sh, -ies for a
# consonant and y, -s otherwise.
fn regular_plural(word) {
    cs = chars(word)
    n = len(cs)
    end1 = if n > 0 { lower(cs[n - 1]) } else { "" }
    end2 = if n > 1 { lower(cs[n - 2]) + end1 } else { end1 }
    if contains(["s", "x", "z"], end1) or contains(["ch", "sh"], end2) { return word + "es" }
    if end1 == "y" and n > 1 and contains(["a", "e", "i", "o", "u"], lower(cs[n - 2])) == false {
        return join(take(cs, n - 1), "") + "ies"
    }
    word + "s"
}

## A count and a word, the word in the plural for anything but 1 or -1.
##
## The plural follows the regular English endings (`bus` to `buses`, `city` to
## `cities`); pass it for anything irregular. A Float count is truncated
## first. The `inflect` package knows irregular words.
##
## errors: `bug`/`bad_argument` when `n` is not a finite number or a word is
## not a string.
##
## example:
##   humanize.plural(3, "day")                # "3 days"
##   humanize.plural(2, "person", "people")   # "2 people"
export fn plural(n, singular, plural = null) {
    k = whole(n, "plural", "n")
    unless type_of(singular) == "string" {
        bad_argument("plural", "singular", "a string", singular)
    }
    unless is_null(plural) or type_of(plural) == "string" {
        bad_argument("plural", "plural", "a string or null", plural)
    }
    word = if k == 1 or k == -1 {
        singular
    } else if plural == null {
        regular_plural(singular)
    } else {
        plural
    }
    "{k} {word}"
}
