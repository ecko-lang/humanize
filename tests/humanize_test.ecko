# Tests for the humanize package - offline, deterministic (no ai/fs/net).
#
# This package replaced the native `std.humanize` module, and most expected
# values below were produced by `std.humanize` itself (Ecko 0.58) and frozen.
# The exceptions are the native module's own bugs, fixed here on purpose: the
# negative ordinals, a size that rounds up into the next unit, the sign of a
# negative size, and plurals of words ending in s, x, z, ch, sh or a
# consonant and y.
import std.test
import "../main.ecko"
h = main

test.case("duration takes milliseconds and shows the two largest units", fn() {
    test.eq(h.duration(0), "0s")
    test.eq(h.duration(1), "1ms")
    test.eq(h.duration(250), "250ms")
    test.eq(h.duration(999), "999ms")
    test.eq(h.duration(1000), "1s")
    test.eq(h.duration(45000), "45s")
    test.eq(h.duration(90000), "1m 30s")
    test.eq(h.duration(3600000), "1h")
    test.eq(h.duration(7505000), "2h 5m")
    test.eq(h.duration(90061000), "1d 1h")
    test.eq(h.duration(-90000), "1m 30s")
    test.eq(h.duration(1.5), "1ms")
})

test.case("size is 1024-based with one decimal, ties to even", fn() {
    test.eq(h.size(0), "0 B")
    test.eq(h.size(512), "512 B")
    test.eq(h.size(1023), "1023 B")
    test.eq(h.size(1024), "1 KB")
    test.eq(h.size(1536), "1.5 KB")
    test.eq(h.size(535808), "523.2 KB")
    test.eq(h.size(1468006), "1.4 MB")
    test.eq(h.size(1073741824), "1 GB")
    test.eq(h.size(1099511627776), "1 TB")
    test.eq(h.size(-1023), "-1023 B")
})

test.case("ordinal handles the 11-13 trap and negatives by their magnitude", fn() {
    test.eq(h.ordinal(0), "0th")
    test.eq(h.ordinal(1), "1st")
    test.eq(h.ordinal(2), "2nd")
    test.eq(h.ordinal(3), "3rd")
    test.eq(h.ordinal(4), "4th")
    test.eq(h.ordinal(11), "11th")
    test.eq(h.ordinal(12), "12th")
    test.eq(h.ordinal(13), "13th")
    test.eq(h.ordinal(21), "21st")
    test.eq(h.ordinal(22), "22nd")
    test.eq(h.ordinal(23), "23rd")
    test.eq(h.ordinal(101), "101st")
    test.eq(h.ordinal(111), "111th")
    test.eq(h.ordinal(112), "112th")
    test.eq(h.ordinal(113), "113th")
    test.eq(h.ordinal(-1), "-1st")
    test.eq(h.ordinal(-2), "-2nd")
    test.eq(h.ordinal(-11), "-11th")
    test.eq(h.ordinal(-21), "-21st")
    test.eq(h.ordinal(21.0), "21st")
    test.eq(h.ordinal(-9223372036854775807 - 1), "-9223372036854775808th")
})

test.case("plural adds s unless given the plural, and keeps the singular for 1 and -1", fn() {
    test.eq(h.plural(1, "day"), "1 day")
    test.eq(h.plural(0, "day"), "0 days")
    test.eq(h.plural(2, "day"), "2 days")
    test.eq(h.plural(-1, "day"), "-1 day")
    test.eq(h.plural(2, "person", "people"), "2 people")
    test.eq(h.plural(1, "person", "people"), "1 person")
})

test.case("relative reads past and future, just-now within five seconds, and saturates", fn() {
    test.eq(h.relative(0, 0), "just now")
    test.eq(h.relative(0, 4999), "just now")
    test.eq(h.relative(0, 5000), "5 seconds ago")
    test.eq(h.relative(0, 60000), "1 minute ago")
    test.eq(h.relative(0, 7200000), "2 hours ago")
    test.eq(h.relative(0, 259200000), "3 days ago")
    test.eq(h.relative(0, 3888000000), "1 month ago")
    test.eq(h.relative(0, 63072000000), "2 years ago")
    test.eq(h.relative(7200000, 0), "in 2 hours")
    test.eq(h.relative(-9223372036854775807 - 1, 9223372036854775807), "292471208 years ago")
})

test.case("a non-number is refused, naming the function", fn() {
    r = try { h.duration("soon") } catch (e) { e.message }
    test.ok(contains(r, "humanize.duration: ms must be a number"), r)
})

test.case("the refusal is shaped like the native module's", fn() {
    e = try { h.size([]) } catch (err) { err }
    test.eq(e.kind, "bug")
    test.eq(e.reason, "bad_argument")
})

test.case("size moves to the next unit when rounding reaches 1024", fn() {
    test.eq(h.size(1048575), "1 MB")
    test.eq(h.size(1073741823), "1 GB")
    test.eq(h.size(1048524), "1023.9 KB")
})

test.case("size keeps the sign of a negative count", fn() {
    test.eq(h.size(-2048), "-2 KB")
    test.eq(h.size(-1468006), "-1.4 MB")
})

test.case("ordinal refuses a fractional number or a non-number", fn() {
    for bad in [21.9, "3", null, 1e30] {
        e = try { h.ordinal(bad) } catch (err) { err }
        test.eq(e.kind, "bug")
        test.eq(e.reason, "bad_argument")
        test.ok(contains(e.message, "humanize.ordinal"), e.message)
    }
})

test.case("plural adds es after s, x, z, ch and sh, and ies after a consonant and y", fn() {
    test.eq(h.plural(2, "bus"), "2 buses")
    test.eq(h.plural(2, "box"), "2 boxes")
    test.eq(h.plural(2, "match"), "2 matches")
    test.eq(h.plural(2, "dish"), "2 dishes")
    test.eq(h.plural(2, "city"), "2 cities")
    test.eq(h.plural(2, "day"), "2 days")
    test.eq(h.plural(1, "bus"), "1 bus")
})

test.case("plural refuses words that are not strings", fn() {
    for call in [fn() h.plural(2, null), fn() h.plural(2, "a", 5)] {
        e = try { call() } catch (err) { err }
        test.eq(e.kind, "bug")
        test.eq(e.reason, "bad_argument")
    }
})

test.case("a Float that is not finite is refused, not crashed on", fn() {
    e = try { h.duration(1e300 * 1e300) } catch (err) { err }
    test.eq(e.kind, "bug")
    test.eq(e.reason, "bad_argument")
})
